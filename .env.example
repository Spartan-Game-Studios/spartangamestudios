# Build-time configuration for the site. Vite inlines anything prefixed VITE_
# into the public bundle — NOTHING here is secret, and nothing secret may be
# added. In CI these come from repository variables/secrets; see deploy.yml.

# Nakama client API, over TLS. A GitHub Pages site is HTTPS, so an http:// URL
# here is blocked by the browser as mixed content.
VITE_NAKAMA_URL=https://daemongate.io/spartan-services/nakama

# Nakama server key. Public by design — game clients embed it too. Abuse is
# handled by the rate limit in front of the auth endpoints, not by hiding this.
VITE_NAKAMA_SERVER_KEY=

# Google Identity Services client id, for the "Continue with Google" button.
# Must be a Web application client with this site's origin listed under
# Authorized JavaScript origins. Leave blank to hide the Google button entirely.
VITE_GOOGLE_CLIENT_ID=
