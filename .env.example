# Build-time configuration for the site. Vite inlines anything prefixed VITE_
# into the public bundle — NOTHING here is secret, and nothing secret may be
# added. In CI these come from repository variables/secrets; see deploy.yml.

# Nakama client API, over TLS. A GitHub Pages site is HTTPS, so an http:// URL
# here is blocked by the browser as mixed content.
VITE_NAKAMA_URL=https://daemongate.io/spartan-services/nakama

# Nakama server key. Public by design — game clients embed it too. Abuse is
# handled by the rate limit in front of the auth endpoints, not by hiding this.
VITE_NAKAMA_SERVER_KEY=

# Google Identity Services client id, for the "Continue with Google" button.
# Must be a Web application client with this site's origin listed under
# Authorized JavaScript origins. Leave blank to hide the Google button entirely.
VITE_GOOGLE_CLIENT_ID=

# itch.io OAuth application client id, from itch.io/user/settings/oauth-apps.
# The redirect URI registered there must be https://spartangamestudios.com/account
# Leave blank to hide the itch.io connect button entirely.
VITE_ITCH_CLIENT_ID=

# Merch backend base URL (the services/merch on the box). It holds the Stripe
# SECRET key + Yoycol creds and turns a cart into a PaymentIntent. Leave blank
# and the shop is browse-only: the card widget renders but Pay stays disabled.
VITE_MERCH_API_URL=

# Stripe PUBLISHABLE key for the embedded card widget (Stripe Elements). Public
# by design — it identifies the account, it cannot move money. Use a pk_test_
# key until go-live, then a pk_live_. NEVER put an sk_ (secret) key here; it
# would be world-readable in the static bundle. Blank hides the card widget.
VITE_STRIPE_PUBLISHABLE_KEY=
